# ===== Vertical 9:16 companion stream (YouTube Shorts feed) =====
# Copy this file to conf/vertical.env (chmod 600) and fill in VERT_KEY.
# conf/vertical.env is gitignored because it holds that stream key; this example is tracked.
#
# The Shorts feed has its own liveStream + key on the same channel. Never share the 16:9
# key: two publishers on one key fight each other on YouTube. Its LaunchAgent is
# com.user.cctv-vertical, and nothing else reads this file.
VERT_ENABLED="no"        # set to yes once VERT_KEY is filled - a half-configured agent
                         # must not go live with an empty key
VERT_KEY=""              # YouTube liveStream key for the 9:16 stream (never commit)
VERT_URL="rtmp://a.rtmp.youtube.com/live2"

VERT_TITLE="Live CCTV Batam - Ternak Laundry Bengkong #shorts #live #livestream #cctv #batam #indonesia"
VERT_PRIVACY="public"

# Canvas and rate. 720x1280 is what this box runs: two thirds of a 9:16 frame is black
# letterbox, so 1080x1920 costs 2.25x the pixels to encode the same visible picture; the
# camera panel is what carries the detail. 1080x1920 is the maximum.
VERT_SIZE="720x1280"
VERT_BITRATE="1500k"     # 720x1280; 2500k is the usual 1080x1920 value
VERT_AUDIO_BITRATE="128k"
VERT_FPS="14"            # the camera's own rate; more only duplicates frames

# Rotation. VERT_ROTATE="no" = ONE broadcast forever: this feed ignores the 16:9 cut and
# has no age fallback of its own, so it never stops. YouTube stops archiving a broadcast
# at 12 h, so the recording past that point is lost while the stream continues.
# "yes" = follow the 16:9 clock (log/broadcast_started) and cut with it, plus an age
# fallback at VERT_ROTATE_HOURS/VERT_ROTATE_MINUTES + the grace after the last cut.
VERT_ROTATE="no"
VERT_ROTATE_HOURS="8"
VERT_ROTATE_MINUTES="10"

# Stay live on the offline card if the camera drops AFTER the feed has been up once.
VERT_SLATE="yes"
# Do not go public with only a slate: wait until the camera has been seen once.
VERT_START_ON_CAMERA="no"
VERT_CAM_PATH="ch00_0"
