# ===== CCTV -> YouTube live stream config =====
# Camera RTSP (main stream). Sub stream = .../live/ch00_1
# The camera is on DHCP and its firmware ignores ONVIF config writes, so it cannot be
# given a static IP from here. After a power cut its address WILL move (it went .2 -> .3
# on 2026-08-31, and the Mac's own LAN port took the old .2). The reader therefore
# re-discovers the camera via ONVIF whenever this address stops answering.
CAM_URL="rtsp://192.168.1.3/live/ch00_0"

# YouTube ingest. Get your stream KEY from YouTube Studio > Go Live > Stream settings.
# Paste only the key (looks like xxxx-xxxx-xxxx-xxxx-xxxx). Do NOT commit this file anywhere public.
YT_KEY=""              # <-- your YouTube stream key goes here (keep this file chmod 600)
YT_URL="rtmp://a.rtmp.youtube.com/live2"

# Mode: "crop"   = cut the one timestamped 1920x1080 panel out of the 1920x3240 stack.
#                  Current: ~50% of one core.
#       "encode" = letterbox the whole tall stack into 16:9.
# stream.sh only implements those two (its case has no other arm). There is NO passthrough
# mode: the publisher always re-encodes with h264_videotoolbox, whatever MODE is.
MODE="crop"

# --- Camera layout note ---
# ch00_0 is a 1920x3240 composite: THREE 1920x1080 views stacked vertically.
# Only the TOP panel (offset y=0) has the date/time OSD overlay.
#   top    panel -> 1920:1080:0:0     <-- has timestamp
#   middle panel -> 1920:1080:0:1080
#   bottom panel -> 1920:1080:0:2160
CROP_GEOM="1920:1080:0:0"
SRC_FPS="14"          # UNREAD by any script. Kept as documentation of the camera's real
                      # rate; stream.sh reads no frame rate except OUT_FPS and the 2 fps
                      # filler still. Do not tune it expecting an effect.

# encode/crop settings
ENC_BITRATE="6800k"   # the rate YouTube Studio asks for at 1080p30.
                      # Wi-Fi caveat: the link negotiates only 54 Mbps legacy (MCS=-1, no
                      # 802.11n/ac) and the camera shares that radio, so a higher upload
                      # makes the camera drop more often. With the two-process design a
                      # camera drop no longer blacks out YouTube - it just freezes the
                      # picture - but wired Ethernet is still the real fix.
ENC_SIZE="1920x1080"     # letterboxes the tall native frame into 16:9
ENC_FPS="15"          # UNREAD by any script. OUT_FPS is the only frame rate stream.sh uses.

# ===== Audio =====
# CCTV microphone audio is NEVER streamed (privacy). Audio comes from the MP3 library.
MP3_DIR="$HOME/Downloads/YTLive/MP3"   # read ONLY by bin/shuffle_playlist.sh (not by
                                       # stream.sh, which uses PLAYLIST below).
PLAYLIST="$HOME/Downloads/YTLive/conf/playlist.txt"
# AAC for YouTube live: ffmpeg's native encoder at 384k, 48kHz stereo.
AAC_ENC="aac"        # ffmpeg native AAC. Chosen over Apple's "aac_at" because aac_at HARD-CAPS
                     # at 320k inside this filter chain ("Bitrate 384000 not allowed") even
                     # though the FLV metadata still claims 384k. Native aac encodes a true 384k.
AUD_BITRATE="384k"   # YouTube live documented maximum for audio.
# "yes" = build a fresh random order every time the stream (re)starts.
# "no"  = keep the saved order in conf/playlist.txt until you rerun shuffle_playlist.sh.
RESHUFFLE_ON_START="no"

# Audio filter chain. alimiter guards against clipping: the bass-boosted MP3s already
# peak at 0.0 dBFS and AAC encoding can overshoot that.
AUDIO_FILTER="aresample=async=1:first_pts=0,alimiter=limit=0.95"

# ===== Video output / enhancement =====
# Camera delivers ~14fps. YouTube gets a CONSTANT 30fps.
OUT_FPS="30"
# UNREAD by any script. The filter chain is hardcoded to [0:v]fps=${OUT_FPS}[base], i.e.
# the fps filter runs on the filler BASE layer and the camera chain stays at the camera's
# own rate. Setting this to "blend" does nothing today; only the "dup" behaviour exists.
# True motion-compensated interpolation (minterpolate) was benchmarked at 0.04x realtime
# on this 2-core i5 - roughly 25x too slow - so it is NOT an option here either.
FPS_MODE="dup"

# Enhancement chain. All YUV-native: no rgb round-trip (the "vibrance" filter forces
# yuv420p->rgb24->yuv420p and costs ~3x more, so eq=saturation is used instead).
DENOISE="hqdn3d=3:2:4:4"              # tames the camera's H.264 blocking/mosquito noise
SHARPEN="unsharp=5:5:0.7:5:5:0"       # gentle; higher amplifies compression artifacts
SATURATION="eq=saturation=1.05"       # +5% colour
# Set any of the three to "" to disable it.

# Watchdog: restart ffmpeg if no new video frame for this many seconds.
# Guards against the camera's RTSP feed dying while ffmpeg keeps streaming music only.
STALL_TIMEOUT="30"

# ===== Filler frames (keeps YouTube fed during camera hiccups) =====
# The filler is ALWAYS on; FILLER is UNREAD by any script. A base layer always runs with
# the camera overlaid on top. If the camera stalls or drops, the overlay holds the LAST
# GOOD FRAME and the stream keeps sending a genuine constant 30fps, so YouTube never sees
# a dropout. Costs one extra overlay pass; measured 30.0fps @ speed 1.01x, still realtime.
FILLER="yes"             # UNREAD - the behaviour described here is unconditional.
FILLER_BG="black"        # fallback colour ONLY when no snapshot exists yet (very first run)
# The filler still is re-grabbed from the camera at every publisher start (start_publisher),
# so there is no periodic snapshot timer. SNAP_INTERVAL is UNREAD by any script.
SNAP_INTERVAL="5"        # UNREAD - snapshots happen per publisher start, not on a timer.

# UNREAD by any script, and its old comment was wrong: the watchdog does NOT watch the
# camera's TCP session. It watches STALL_TIMEOUT on the OUTPUT frame counter (log/progress.txt).
# With the filler always on, that counter keeps advancing on a held frame, so the implemented
# watchdog cannot see a dead camera; the only camera liveness check is cam_ip_watcher's
# `nc -z -G 3 <ip> 554` every 30s, which re-discovers and rewrites CAM_URL but never
# restarts the publisher.
CAM_LINK_TIMEOUT="45"    # UNREAD - kept as a record of the intended design, not in force.

# ===== Delay buffer (the thing that actually pins output to a constant 30fps) =====
# The camera's timestamps are shifted CAM_DELAY seconds into the future with -itsoffset,
# so the overlay's framesync always has camera frames buffered ahead of the base layer and
# never blocks waiting for the next one. Net effect: the picture is CAM_DELAY seconds
# behind live, and output is a rock-steady 30fps regardless of camera jitter.
# Measured: 1800 frames / 60s = 30.00fps, speed 1.01x (without it: 21-25fps, speed 0.65-0.95).
# Costs ~CAM_DELAY x 14fps x 3MB of buffered frames (3s ~= 125MB).
CAM_DELAY="3"

# ===== Self-check monitor (bin/yt_monitor.sh) =====
# Channel handle. The monitor resolves <channel>/live every check, so it always finds
# whatever broadcast is currently live - no need to update a video id by hand.
YT_CHANNEL="@ternaklaundrybengkong"
YT_WATCH_URL=""       # optional override; leave empty to use YT_CHANNEL
CHECK_INTERVAL="20"   # seconds between frame pulls from YouTube. Each check spawns yt-dlp
                      # AND ffmpeg and costs ~2.0 CPU-seconds; at 10s that was ~15% of a
                      # core burning continuously on a box with 17% idle. Thresholds are
                      # wall-clock (FAIL_SECONDS/OFFLINE_SECONDS) so raising this changes
                      # sampling granularity, not how long a fault must persist to act.
CORR_MIN="0.15"       # structural correlation vs conf/golden.jpg below which a frame is "wrong".
                      # LOWERED FROM 0.35 on 2026-09-08 after it caused the first
                      # picture-triggered restart in the project's history, on a stream that
                      # was completely healthy. Measured that night: correlation runs ~0.98
                      # just after golden is refreshed and decays to 0.32-0.42 within 25
                      # minutes as people move things around the shop. At 0.35 that is no
                      # margin at all - and the restart refreshes golden, so it would trip
                      # again ~25 min later, cycling all night. Black, frozen and garbage
                      # frames score near zero or negative, so 0.15 still catches every
                      # failure this check exists for.
                      # Was 0.60; real scene drift over days measured 0.52-0.64 on a healthy stream,
                      # while black scores ~0.01 and garbage ~-0.2, so 0.35 keeps a wide gap both ways.
                      # Pearson correlation is brightness/contrast invariant, so day->night is fine;
                      # people walking through barely move it. Black/frozen/garbage tank it.
# Thresholds are SECONDS OF SUSTAINED FAILURE, not counts of checks. They were counts, and
# counts lied: each check spawns yt-dlp AND ffmpeg, so the "10s" interval measured 14s median
# and 118s worst case, making "6 checks = 1 min" really ~1.4 min and "30 checks = 5 min" ~7.
FAIL_SECONDS="90"     # bad PICTURE (black/frozen/mismatch) before restarting the publisher
MONITOR_ACTION="restart"   # "restart" the streamer, or "log" to only report

# Local UDP hop between the reader and the publisher (loopback only, nothing exposed).
UDP_PORT="5000"

# NOTE: the local UDP hop needs BIG buffers. With ffmpeg's small defaults, an RTMP write
# stall makes the publisher stop draining the socket, packets are lost, and output
# collapses to ~8fps. With fifo_size=8000000 + buffer_size=8388608 (= kern.ipc.maxsockbuf)
# it holds a clean 30fps at 6982kbps. Do not shrink these.

# ===== Broadcast rotation =====
# Stop ingest every ROTATE_HOURS so YouTube closes and SAVES the broadcast (YouTube only
# archives streams up to 12h), then start the publisher again. The successor is NOT created
# by the push: start_publisher -> prepare_broadcast runs `yt_api.py prepare` on EVERY start,
# creating and binding it BEFORE ffmpeg pushes. YouTube retired automatic/default broadcast
# creation in 2020 (developers.google.com/youtube/v3/live/guides/migration-guide-default-broadcasts),
# so the API is required for every rotation. Force one any time with:
#   touch ~/Downloads/YTLive/log/rotate_now
ROTATE_HOURS="8"
ROTATE_MINUTES="3"      # cut at 8h03m, not 8h. YouTube's encode loses 0.6-2.3 min turning
                        # the live stream into a VOD (measured over five broadcasts), so an
                        # exactly-8h cut always yielded a recording just under 8h. This puts
                        # the SAVED recording a tick over 8h instead of a tick under.
ROTATE_MAX_WAIT="600"   # max seconds to wait for YouTube to report the old broadcast closed
ROTATE_GAP="180"        # silence after YouTube closes the old broadcast, before resuming
                        # ingest. 3 min: YouTube closed the broadcast in 9s (measured - its
                        # enableAutoStop), and the already-bound successor went live once
                        # ingest returned. Raise it if a rotation ever fails.
ROTATE_NATIVE_WAIT="360"  # how long autoStart may take to bring the ALREADY-BOUND broadcast
                          # live before the streamer bounces ingest and, after that, falls
                          # back to `ensure-live`. It does NOT mean YouTube creates anything:
                          # with no API the channel stays dark. Measured 2026-09-05: six
                          # minutes of clean ingest against a dark channel produced nothing.
ROTATE_END_PATIENCE="60"  # if YouTube has not closed the old broadcast by now, end it via API
ROTATE_GRACE="420"        # logged after every publisher start; it no longer drives the actual
                          # hold (that is ROTATE_NATIVE_WAIT + 120 = 480s - see stream.sh's
                          # hold_monitor calls). Kept because the log line still prints it.
ROTATE_MIN_INTERVAL="900" # hard floor between unscheduled rotations. Backstop against the
                          # monitor and the rotation killing the stream in a loop.
ROTATE_WITHOUT_API="no"   # "no" (default): if the API cannot create the successor, the
                          # rotation is REFUSED and the stream stays LIVE. That segment then
                          # runs past 12h and is not archived, but a lost recording beats a
                          # dark channel, which needs a human anyway. "yes" restores the old
                          # cut-anyway behaviour: dark until credentials return.
ROTATE_API_RETRY="900"    # after a refused rotation, seconds before the loop re-checks. Sets
                          # ROTATE_BLOCKED_UNTIL so a refused cut is not retried every 5s.
OFFLINE_SECONDS="300"     # channel confirmed dark this long before the monitor calls
                          # ensure-live. Must stay well under the publisher-start hold.
BLIND_SECONDS="300"       # yt-dlp unable to answer this long before we ask the YouTube API
                          # instead. A failed LOOKUP is never treated as an offline channel.
ROTATE_REQUEST_BACKOFF="900"  # monitor silence after it asks for a rotation
TOKEN_CHECK_EVERY="21600" # how often the monitor re-checks OAuth expiry (local, no network)

# Advisory refresh-token countdown, in days (yt_api.py reads it from the ENVIRONMENT; lib.sh's
# yt_api_call forwards it explicitly too). 7 is the lifetime Google gives a refresh token while
# the OAuth app's publishing status is "Testing"; a PUBLISHED app's token does not expire on a
# clock, so set 0 once published to silence a countdown that is then pure noise. The real answer
# comes from `yt_api.py token`, which PROBES the credential. conf/stream.env is sourced, not
# exported, so the `export` here is what also reaches direct `yt_api.py token` calls (status.sh).
export YT_TOKEN_TTL_DAYS="7"

# --- housekeeping -------------------------------------------------------------------
# Nothing bounded the logs before; publisher.log is ffmpeg stderr and grew without limit.
# Logs exist for the project's own bookkeeping, not to be read. The publisher now runs at
# -loglevel error (the MP3 concat input emitted a "Resumed reading after a lag" warning every
# few seconds - 5700+ repeats and most of a 6 MB file), so 512 KB is plenty of tail to
# diagnose an incident with.
LOG_MAX_BYTES="524288"    # 512 KB cap per log file, trimmed in place (keeps the tail)
# No notifications: this Mac is unattended, so nothing may depend on a human seeing anything.
# Every failure path keeps retrying instead of reporting.
HOUSEKEEP_EVERY="300"     # seconds between housekeeping passes
MONITOR_STALE="600"       # watchdog heartbeat older than this = hung; stream.sh restarts it

# Title for broadcasts the API creates at each rotation. strftime codes are expanded.
# Without this the title falls back to a bare default and loses the hashtags the channel
# relies on for discovery.
YT_TITLE_FMT="Live CCTV Batam - Ternak Laundry Bengkong #live #livestream #cctv #batam"
YT_PRIVACY="public"
THUMB_GIVEUP="7200"    # stop waiting for YouTube's suggestions this long after the cut and
                       # take a frame from the video instead. An 8h video can go hours
                       # without offering any; a real frame beats leaving the auto-pick.
THUMB_FRAME_AT="01:00:00"   # which moment to grab. The frame is rejected if it is black or
                       # featureless and nearby offsets are tried, so a glitch at exactly
                       # that second does not become the thumbnail.
THUMB_DELAY="3600"     # after a cut, wait this long before adopting YouTube's first
                       # suggested frame for the finished video. YouTube discards the live
                       # broadcast's thumbnail when it becomes a video; its suggestions
                       # appear about an hour later. Only ever applied to a video that
                       # still has the auto-pick - a custom thumbnail is never overwritten.
ENFORCE_EVERY="1800"   # seconds between configuration drift checks against
                       # conf/broadcast_template.json. One cheap read when nothing is wrong.
YT_LATENCY="normal"    # normal | low | ultraLow. NORMAL on purpose: low latency trades away
                       # DVR depth and archive robustness, and nothing interacts with this
                       # feed live - the reviewable recording is the point.
