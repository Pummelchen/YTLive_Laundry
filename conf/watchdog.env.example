# External watchdog configuration  (bin/yt_watchdog.py)
#
# Copy to conf/watchdog.env (gitignored) and fill in the secret. This file is the TRACKED
# template; the live one holds a Gmail app password and must never be committed.
#
# This component is the one thing here that runs OFF the streamer, on an always-on host.
# It exists because on 2026-09-18 the streamer dropped off the network mid-segment and the
# channel stayed dark for 10 h 23 m while every other failure path "retried" - which is no
# help at all on a machine that is off. See docs/watchdog.md.

# --- what to watch ---------------------------------------------------------------------
# The channel, exactly as conf/stream.env spells it for the streamer. Either an "@handle" or
# a raw UC... channel id; a channel id builds youtube.com/channel/UC.../live, a handle builds
# youtube.com/@handle/live.
WATCH_CHANNEL="@ternaklaundrybengkong"
# The streamer's Tailscale peer name. Used to tell "the box is gone" (power/network) from
# "the box is up but the stream is broken" (publisher, token, camera).
WATCH_HOST="ternak-macbook"

# The second, independent channel reader: a plain HTTPS GET of the public /live page, which
# still answers when yt-dlp is rate-limited or bot-checked. Either reader saying live wins;
# only BOTH saying offline is dark; anything else is unknown and never pages anyone.
# WATCH_HTTP=0 falls back to the yt-dlp reader alone.
WATCH_HTTP="1"
WATCH_HTTP_TIMEOUT="15"          # short: a hanging page must not stall the loop
# WATCH_HTTP_URL=""              # optional override; default derives from WATCH_CHANNEL

# The dead-man signal: a file the streaming app's heartbeat pushes WRITE, on this host. If the
# file exists but its mtime is older than WATCH_HEARTBEAT_MAX, the APPLICATION has gone silent,
# and that pages a human even while the channel read is UNKNOWN.
#
# The transport is a PUSH (tracker row T-34): the streamer POSTs to bin/yt_heartbeat.py serve on
# this host, and the listener atomically replaces the file below with the request body. This is
# the ONLY writer; the watchdog only stats the file. Push and not pull on purpose - this host
# holds the Gmail app password and must never be able to reach into the streamer. See
# docs/watchdog.md and docs/files.md.
#
# An ABSENT file is NOT stale and never alerts (that is an unconfigured deployment, not an
# outage), so leaving WATCH_HEARTBEAT empty is safe. Once it is set, the listener must be
# running: a stopped ytlive-heartbeat makes the file go stale and the watchdog will page for a
# HEALTHY streamer. That alarm is real - the file really is stale - and this unit is the cause.
WATCH_HEARTBEAT="/var/ytlive-watchdog/heartbeat"   # written by `yt_heartbeat.py serve`
WATCH_HEARTBEAT_MAX="900"        # 15 min without a push -> the app is silent

# --- the heartbeat listener (bin/yt_heartbeat.py serve, ytlive-heartbeat.service) ---------
# Same EnvironmentFile, so both halves agree on where the file and the secret live. The unit
# expands these into its ExecStart.
HEARTBEAT_BIND="100.99.149.11"   # the VPS TAILNET address - never 0.0.0.0. WireGuard encrypts
                                 # the tailnet, so plain HTTP here is correct; do NOT add TLS.
HEARTBEAT_PORT="8787"            # check it is free first: `ss -ltn | grep 8787`
HEARTBEAT_STATE_FILE="/var/ytlive-watchdog/heartbeat"   # must match WATCH_HEARTBEAT above
HEARTBEAT_TOKEN_FILE="/var/ytlive-watchdog/conf/heartbeat.token"   # mode 600, shared secret
# Create it on this host and copy the SAME value into the streamer's conf/heartbeat.token:
#     install -m 600 /dev/null /var/ytlive-watchdog/conf/heartbeat.token
#     printf '%s' "$(openssl rand -hex 24)" | tee /var/ytlive-watchdog/conf/heartbeat.token \
#       > ~/heartbeat.token    # then move the second copy to the streamer

# --- where it keeps its memory (outside the repository) --------------------------------
WATCH_STATE_DIR="/var/ytlive-watchdog"

# --- how patient to be, in seconds ----------------------------------------------------
# A healthy rig is dark ~5 min every 8h03m (measured 4.5-5.2 min over four segments), so
# this must sit comfortably above that.
WATCH_DARK_GRACE="900"          # 15 min dark -> alert
WATCH_HOST_LOST_GRACE="900"     # host gone AND channel unreadable for 15 min -> alert
WATCH_BLIND_GRACE="2700"        # 45 min unable to read the channel at all -> warn anyway
WATCH_REMIND="21600"            # 6 h: repeat an unresolved outage this often
WATCH_INTERVAL="60"             # seconds between checks
WATCH_YTDLP_TIMEOUT="90"

# --- alert delivery -------------------------------------------------------------------
# smtp (default) | file | stdout.  Use file/stdout to test without sending anything.
WATCH_ALERT_MODE="smtp"
WATCH_ALERT_TO="0xa0b1@gmail.com"
WATCH_ALERT_FROM="0xa0b1@gmail.com"

# Gmail enforces SPF or DKIM on every sender, so unauthenticated direct-to-MX from a VPS is
# rejected (550 5.7.26, verified 2026-09-18). Submission with an app password is the
# supported path: myaccount.google.com/apppasswords (needs 2FA), 16 characters.
WATCH_SMTP_HOST="smtp.gmail.com"
WATCH_SMTP_PORT="587"
WATCH_SMTP_USER="0xa0b1@gmail.com"
WATCH_SMTP_PASS=""

# --- optional overrides ---------------------------------------------------------------
# WATCH_YTDLP="/usr/local/bin/yt-dlp"
# WATCH_TAILSCALE="/usr/bin/tailscale"
# WATCH_TZ_OFFSET="7"           # shop time (WIB)
# WATCH_TZ_LABEL="WIB"
