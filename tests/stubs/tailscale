#!/bin/zsh
# Test stub for the external watchdog's host-presence signal (Tailscale).
#
# Reads log/fake_tailscale:
#   live -> the streamer peer is Online
#   down -> the streamer peer is offline with a LastSeen
#   anything else, or no file -> no peers, so the watchdog must report host "unknown"
# The real tailscale is never invoked by the suite.
FAKE="${BASE:-/nonexistent}/log/fake_tailscale"
case "${1:-}" in
  status)
    if [[ "$*" == *--json* && -f "$FAKE" ]]; then
      case "$(cat "$FAKE")" in
        # The ONLINE case carries Go's zero time, which is what the real tailnet reports:
        # measured 2026-09-19, the streamer, Node1-4 and MacBook AB all return
        # "0001-01-01T00:00:00Z" while online, while genuinely offline peers carry a real
        # timestamp. A stub that invented a plausible date here is exactly why the "last seen
        # 1-01-01" display bug survived: the suite never produced the input that triggers it.
        live) print -- '{"Peer":{"k":{"HostName":"ternak-macbook","DNSName":"ternak-macbook.tail1c3b90.ts.net.","Online":true,"LastSeen":"0001-01-01T00:00:00Z"}}}' ;;
        down) print -- '{"Peer":{"k":{"HostName":"ternak-macbook","DNSName":"ternak-macbook.tail1c3b90.ts.net.","Online":false,"LastSeen":"2026-09-18T10:20:00Z"}}}' ;;
      esac
    else
      print -- '{"Peer":{}}'
    fi
    exit 0 ;;
esac
exit 0
